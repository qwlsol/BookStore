@page
@model BookStore.Pages.Books.CreateModel
@{
    ViewData["Title"] = "Добавить книгу";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h1 class="text-success mb-0">Внести данные о книге</h1>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label text-success fw-semibold">Название</label>
                            <input asp-for="Book.Title" class="form-control" />
                            <span asp-validation-for="Book.Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-success fw-semibold">Автор</label>
                            <input asp-for="Book.Author" class="form-control" />
                            <span asp-validation-for="Book.Author.Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-success fw-semibold">Цена</label>
                            <input asp-for="Book.Price" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Book.Price" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-success fw-semibold">Количество</label>
                            <input asp-for="Book.Quantity" type="number" class="form-control" />
                            <span asp-validation-for="Book.Quantity" class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">Сохранить</button>
                            <a asp-page="Index" class="btn btn-outline-success">Назад</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@page
@model BookStore.Pages.Books.IndexModel
@{
    ViewData["Title"] = "Ассортимент книг";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-success mb-0">Список книг</h1>
        <a asp-page="Create" class="btn btn-success">+ Добавить новую книгу</a>
    </div>

    <div class="row">
        @foreach (var book in Model.Books)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-success fw-bold">@book.Title</h5>
                        <p class="card-text mb-2">
                            <strong class="text-success">Автор:</strong> @book.Author.Name
                        </p>
                        <p class="card-text mb-2">
                            <strong class="text-success">Цена:</strong> @book.Price ₽
                        </p>
                        <p class="card-text">
                            <strong class="text-success">Количество:</strong> @book.Quantity шт.
                        </p>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <div class="btn-group w-100" role="group">
                            <a asp-page="Details" asp-route-id="@book.Id" class="btn btn-outline-success">Открыть</a>
                            <a asp-page="Edit" asp-route-id="@book.Id" class="btn btn-outline-success">Изменить</a>
                            <a asp-page="Delete" asp-route-id="@book.Id" class="btn btn-outline-danger">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
@page "{id:int}"
@model BookStore.Pages.Books.DetailsModel
@{
    ViewData["Title"] = "Информация о книге";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h1 class="text-success mb-0">Информация о книге</h1>
                </div>
                <div class="card-body">
                    <div class="card bg-light">
                        <div class="card-body">
                            <p class="fs-5 mb-3"><strong class="text-success">Название:</strong> @Model.Book.Title</p>
                            <p class="fs-5 mb-3"><strong class="text-success">Автор:</strong> @Model.Book.Author</p>
                            <p class="fs-5 mb-3"><strong class="text-success">Цена:</strong> @Model.Book.Price ₽</p>
                            <p class="fs-5 mb-0"><strong class="text-success">Количество:</strong> @Model.Book.Quantity шт.</p>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a asp-page="Index" class="btn btn-outline-success">Назад к списку</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
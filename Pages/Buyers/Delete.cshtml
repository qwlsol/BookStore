@page
@model BookStore.Pages.Buyers.DeleteModel
@{
    ViewData["Title"] = "Удалить покупателя";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger bg-opacity-10 border-danger">
                    <h3 class="mb-0 text-danger">Удалить покупателя</h3>
                </div>
                <div class="card-body">
                    <p class="mb-4">Вы уверены, что хотите удалить этого покупателя?</p>

                    <div class="bg-secondary bg-opacity-10 p-3 rounded mb-4">
                        <p class="mb-2"><strong>Фамилия:</strong> @Model.Buyer.LastName</p>
                        <p class="mb-2"><strong>Email:</strong> @Model.Buyer.Email</p>
                        <p class="mb-0"><strong>Телефон:</strong> @(string.IsNullOrEmpty(Model.Buyer.Phone) ? "—" : Model.Buyer.Phone)</p>
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="Buyer.Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">Удалить</button>
                            <a asp-page="Index" class="btn btn-outline-secondary">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
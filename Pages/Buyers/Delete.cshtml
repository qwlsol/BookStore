@page
@model BookStore.Pages.Buyers.DeleteModel
@{
}
<h1>Удалить покупателя</h1>

<h3>Вы уверены?</h3>

<div>
    <p><strong>@Model.Buyer.LastName</strong></p>
    <p>@Model.Buyer.Email</p>
    <p>@Model.Buyer.Phone</p>
</div>

<form method="post">
    <input type="hidden" asp-for="Buyer.Id" />
    <button type="submit">Удалить</button>
</form>

<a asp-page="Index">Отмена</a>
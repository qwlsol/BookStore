@page
@model BookStore.Pages.Buyers.CreateModel
@{
}
<h1>Внести данные о покупателе</h1>

<form method="post">
    <div>
        <label>Фамилия</label><br />
        <input asp-for="Buyer.LastName" />
        <span asp-validation-for="Buyer.LastName"></span>
    </div>

    <div>
        <label>Email</label><br />
        <input asp-for="Buyer.Email" />
        <span asp-validation-for="Buyer.Email"></span>
    </div>

    <div>
        <label>Телефон</label><br />
        <input asp-for="Buyer.Phone" />
        <span asp-validation-for="Buyer.Phone"></span>
    </div>

    <button type="submit">Сохранить</button>
</form>

<a asp-page="Index">Назад</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
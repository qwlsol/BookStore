@page
@model BookStore.Pages.Buyers.IndexModel
@{
    ViewData["Title"] = "Список покупателей";
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Список покупателей</h3>
        <a asp-page="Create" class="btn btn-success btn-sm">+ Добавить</a>
    </div>

    @if (!Model.Buyers.Any())
    {
        <div class="text-center text-secondary py-5">
            <p>Покупателей пока нет</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var buyer in Model.Buyers)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100 shadow-sm border-primary">
                        <div class="card-body">
                            <h5 class="card-title text-primary">@buyer.LastName</h5>
                            <p class="card-text small text-secondary mb-2">@buyer.Email</p>
                            <p class="card-text small text-secondary">
                                Телефон: @(string.IsNullOrEmpty(buyer.Phone) ? "—" : buyer.Phone)
                            </p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="btn-group w-100 btn-group-sm">
                                <a asp-page="Details" asp-route-id="@buyer.Id" class="btn btn-outline-info">Открыть</a>
                                <a asp-page="Edit" asp-route-id="@buyer.Id" class="btn btn-outline-warning">Изменить</a>
                                <a asp-page="Delete" asp-route-id="@buyer.Id" class="btn btn-outline-danger">Удалить</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
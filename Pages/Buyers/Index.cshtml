@page
@model BookStore.Pages.Buyers.IndexModel
@{
}
<h1>Список покупателей</h1>

<p>
    <a asp-page="Create">Добавить нового покупателя</a>
</p>

<table border="1" cellpadding="5">
    <thead>
        <tr>
            <th>Фамилия</th>
            <th>Email</th>
            <th>Телефон</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var buyer in Model.Buyers)
        {
            <tr>
                <td>@buyer.LastName</td>
                <td>@buyer.Email</td>
                <td>@(string.IsNullOrEmpty(buyer.Phone) ? "—" : buyer.Phone)</td>
                <td>
                    <a asp-page="Details" asp-route-id="@buyer.Id">Открыть</a>
                    <a asp-page="Edit" asp-route-id="@buyer.Id">Изменить</a>
                    <a asp-page="Delete" asp-route-id="@buyer.Id">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@page
@model BookStore.Pages.Buyers.IndexModel
@{
}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-success mb-0">Список покупателей</h1>
        <a asp-page="Create" class="btn btn-success">+ Добавить нового покупателя</a>
    </div>

    <div class="row">
        @foreach (var buyer in Model.Buyers)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-success fw-bold">@buyer.LastName</h5>
                        <p class="card-text mb-2">
                            <strong class="text-success">Email:</strong> @buyer.Email
                        </p>
                        <p class="card-text">
                            <strong class="text-success">Телефон:</strong> @(string.IsNullOrEmpty(buyer.Phone) ? "—" : buyer.Phone)
                        </p>
                    </div>
                    <div class="card-footer bg-white border-top-0">
                        <div class="btn-group w-100" role="group">
                            <a asp-page="Details" asp-route-id="@buyer.Id" class="btn btn-outline-success">Открыть</a>
                            <a asp-page="Edit" asp-route-id="@buyer.Id" class="btn btn-outline-success">Изменить</a>
                            <a asp-page="Delete" asp-route-id="@buyer.Id" class="btn btn-outline-danger">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
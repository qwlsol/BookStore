@page
@model BookStore.Pages.Buyers.DetailsModel
@{
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h1 class="text-success mb-0">Информация о покупателе</h1>
                </div>
                <div class="card-body">
                    <div class="card bg-light">
                        <div class="card-body">
                            <p class="fs-5 mb-3"><strong class="text-success">Фамилия:</strong> @Model.Buyer.LastName</p>
                            <p class="fs-5 mb-3"><strong class="text-success">Email:</strong> @Model.Buyer.Email</p>
                            <p class="fs-5 mb-0"><strong class="text-success">Телефон:</strong> @(string.IsNullOrEmpty(Model.Buyer.Phone) ? "—" : Model.Buyer.Phone)</p>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a asp-page="Index" class="btn btn-outline-success">Назад к списку</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
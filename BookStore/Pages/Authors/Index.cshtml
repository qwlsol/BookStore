@page
@model BookStore.Pages.Authors.IndexModel
@{
    ViewData["Title"] = "Список авторов";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">Список авторов</h3>
        <a asp-page="Create" class="btn btn-success btn-sm">+ Добавить автора</a>
    </div>

    @if (!Model.Authors.Any())
    {
        <div class="text-center text-secondary py-5">
            <p>Авторов пока нет</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var author in Model.Authors)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100 shadow-sm border-info">
                        <div class="card-body">
                            <h5 class="card-title text-info">@author.Name</h5>
                            <p class="card-text small text-secondary">
                                Книг: @author.Books.Count
                            </p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="btn-group w-100 btn-group-sm">
                                <a asp-page="Details" asp-route-id="@author.Id" class="btn btn-outline-info">Открыть</a>
                                <a asp-page="Edit" asp-route-id="@author.Id" class="btn btn-outline-warning">Изменить</a>
                                <a asp-page="Delete" asp-route-id="@author.Id" class="btn btn-outline-danger">Удалить</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
@page
@model BookStore.Pages.Authors.EditModel
@{
    ViewData["Title"] = "Редактировать автора";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-warning">
                <div class="card-header bg-warning bg-opacity-10 border-warning">
                    <h3 class="mb-0 text-warning">Редактировать автора</h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <input type="hidden" asp-for="Author.Id" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Имя автора</label>
                            <input asp-for="Author.Name" class="form-control" />
                            <span asp-validation-for="Author.Name" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">Сохранить</button>
                            <a asp-page="Index" class="btn btn-outline-secondary">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
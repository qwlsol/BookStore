@page
@model BookStore.Pages.Buyers.DetailsModel
@{
    ViewData["Title"] = "Информация о покупателе";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-info">
                <div class="card-header bg-info bg-opacity-10 border-info">
                    <h3 class="mb-0 text-info">Информация о покупателе</h3>
                </div>
                <div class="card-body">
                    <div class="bg-secondary bg-opacity-10 p-3 rounded">
                        <p class="mb-3"><strong>Фамилия:</strong> @Model.Buyer.LastName</p>
                        <p class="mb-3"><strong>Email:</strong> @Model.Buyer.Email</p>
                        <p class="mb-0"><strong>Телефон:</strong> @(string.IsNullOrEmpty(Model.Buyer.Phone) ? "—" : Model.Buyer.Phone)</p>
                    </div>

                    <div class="mt-4">
                        <a asp-page="Index" class="btn btn-outline-secondary">Назад</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
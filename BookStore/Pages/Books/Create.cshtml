@page
@model BookStore.Pages.Books.CreateModel
@{
    ViewData["Title"] = "Добавить книгу";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-success">
                <div class="card-header bg-success bg-opacity-10 border-success">
                    <h3 class="mb-0 text-success">Добавить книгу</h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Название</label>
                            <input asp-for="Book.Title" class="form-control" />
                            <span asp-validation-for="Book.Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SelectedAuthorId" class="form-label fw-semibold">Автор</label>
                            <select asp-for="SelectedAuthorId" asp-items="Model.AuthorList" class="form-select">
                                <option value="">-- Выберите автора --</option>
                            </select>
                            <span asp-validation-for="SelectedAuthorId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Цена (₽)</label>
                            <input asp-for="Book.Price" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="Book.Price" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Количество</label>
                            <input asp-for="Book.Quantity" type="number" class="form-control" />
                            <span asp-validation-for="Book.Quantity" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">Сохранить</button>
                            <a asp-page="Index" class="btn btn-outline-secondary">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
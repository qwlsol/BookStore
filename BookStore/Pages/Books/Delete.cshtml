@page "{id:int}"
@model BookStore.Pages.Books.DeleteModel
@{
    ViewData["Title"] = "Удалить книгу";
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger bg-opacity-10 border-danger">
                    <h3 class="mb-0 text-danger">Удалить книгу</h3>
                </div>
                <div class="card-body">
                    <p class="mb-4">Вы уверены, что хотите удалить эту книгу?</p>

                    <div class="bg-secondary bg-opacity-10 p-3 rounded mb-4">
                        <p class="mb-2"><strong>Название:</strong> @Model.Book.Title</p>
                        <p class="card-text text-muted">Автор: @Model.Book.Author?.Name</p>
                        <p class="mb-2"><strong>Цена:</strong> @Model.Book.Price ₽</p>
                        <p class="mb-0"><strong>Количество:</strong> @Model.Book.Quantity шт.</p>
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="Book.Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">Удалить</button>
                            <a asp-page="Index" class="btn btn-outline-secondary">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>